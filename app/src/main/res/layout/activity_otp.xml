<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="ConcertX logo"
                    android:src="@drawable/ic_logo"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_serif_display"
                        app:fontFamily="@font/dm_serif_display"
                        android:text="Concert"
                        android:textColor="@color/floral_white"
                        android:textAppearance="@style/TextAppearance.ConcertX.Wordmark"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_serif_display"
                        app:fontFamily="@font/dm_serif_display"
                        android:text="X"
                        android:textColor="@color/coral"
                        android:textAppearance="@style/TextAppearance.ConcertX.Wordmark"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="OTP Verification"
                android:fontFamily="@font/dm_serif_display"
                app:fontFamily="@font/dm_serif_display"
                android:textAppearance="@style/TextAppearance.ConcertX.Headline"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="Enter the 6-digit code sent to your phone"
                android:textColor="?android:attr/textColorSecondary"
                android:textAppearance="@style/TextAppearance.ConcertX.Body"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etOtp1"
                    style="@style/Widget.ConcertX.OtpBox"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    tools:ignore="LabelFor"/>

                <EditText
                    android:id="@+id/etOtp2"
                    style="@style/Widget.ConcertX.OtpBox"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    tools:ignore="LabelFor"/>

                <EditText
                    android:id="@+id/etOtp3"
                    style="@style/Widget.ConcertX.OtpBox"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    tools:ignore="LabelFor"/>

                <EditText
                    android:id="@+id/etOtp4"
                    style="@style/Widget.ConcertX.OtpBox"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    tools:ignore="LabelFor"/>

                <EditText
                    android:id="@+id/etOtp5"
                    style="@style/Widget.ConcertX.OtpBox"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    tools:ignore="LabelFor"/>

                <EditText
                    android:id="@+id/etOtp6"
                    style="@style/Widget.ConcertX.OtpBox"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    tools:ignore="LabelFor"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Verify"/>

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="Resend Code"
                android:textColor="?attr/colorPrimary"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>